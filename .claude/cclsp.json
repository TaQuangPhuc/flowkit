{
  "servers": [
    {
      "extensions": [
        "go"
      ],
      "command": [
        "gopls"
      ]
    },
    {
      "extensions": [
        "py",
        "pyi"
      ],
      "command": [
        "pyright-langserver",
        "--stdio"
      ]
    },
    {
      "extensions": [
        "ts",
        "js",
        "tsx",
        "jsx"
      ],
      "command": [
        "typescript-language-server",
        "--stdio"
      ]
    }
  ]
}